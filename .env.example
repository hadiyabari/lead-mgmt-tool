# =============================================================================
# LeadPilot Retainer Edition – Environment Variables
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public"
REDIS_URL="redis://localhost:6379"

AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# LLM
# ANTHROPIC_API_KEY=

# Official registries
# COMPANIES_HOUSE_API_KEY=
# ABN_LOOKUP_GUID=

# Enrichment (licensed only)
# GOOGLE_PLACES_API_KEY=
# YELP_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Agency audit tool (URL → score + findings)
# AUDIT_TOOL_URL=https://audit.example.com
# AUDIT_TOOL_API_KEY=

# Email
# POSTMARK_API_TOKEN=

SIMULATION_MODE="true"
KILL_SWITCH="false"
MAX_CREDITS_PER_RUN="100"
NODE_ENV="development"
