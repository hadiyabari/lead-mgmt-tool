# =============================================================================
# LeadPilot Retainer Edition – Environment Variables
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public"

# Redis (BullMQ + rate limiting + cache)
REDIS_URL="redis://localhost:6379"

# Auth (Auth.js / NextAuth)
AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth (Phase 4+; credentials work without these)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LLM
# ANTHROPIC_API_KEY=

# Email providers (secondary domains only)
# POSTMARK_API_TOKEN=

# Enrichment / data sources
# GOOGLE_PLACES_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# ABN_LOOKUP_GUID=

# Object storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Observability
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Feature flags / safety
SIMULATION_MODE="true"
KILL_SWITCH="false"
MAX_CREDITS_PER_RUN="100"

# App
NODE_ENV="development"
