# =============================================================================
# LeadPilot Retainer Edition – Environment Variables
# Copy to .env and fill values. NEVER commit real secrets.
# =============================================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadpilot?schema=public"

# Redis (BullMQ + rate limiting + cache)
REDIS_URL="redis://localhost:6379"

# Auth (Auth.js / NextAuth)
AUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# LLM (only one needed initially)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Email providers (secondary domains only)
# POSTMARK_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Enrichment / data sources (official / licensed only)
# GOOGLE_PLACES_API_KEY=
# COMPANIES_HOUSE_API_KEY=
# ABN_LOOKUP_GUID=
# NPI_REGISTRY_ (public, no key usually required)

# Object storage (S3-compatible)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Observability / alerts
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Feature flags / safety
SIMULATION_MODE="true"
KILL_SWITCH="false"
MAX_CREDITS_PER_RUN="100"

# App
NODE_ENV="development"
