// LeadPilot Retainer Edition – Prisma schema
// Phase 2: Tenancy, Users, ICP, Playbooks, SourceConfig
// Phase 3: Leads, Ledger, Messaging, Meetings, Runs, Cost, Suppression

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum Role {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum Vertical {
  DENTAL_ORTHO
  HOME_SERVICES
  AESTHETIC_MEDSPA
  OTHER
}

enum CountryCode {
  US
  UK
  AU
}

enum SourceProvider {
  NPI_US
  STATE_LICENSE_US
  COMPANIES_HOUSE_UK
  ABN_ASIC_AU
  HEALTH_REGISTER_AU
  JOB_BOARD
  GOOGLE_PLACES_ENRICH
  YELP_ENRICH
  WEBSITE_EXTRACT
  CUSTOM
}

enum LeadStatus {
  DISCOVERED
  ENRICHING
  ENRICHED
  SCORED
  QUALIFIED
  EMAIL_RESOLVED
  IN_CAMPAIGN
  CONTACTED
  REPLIED
  MEETING_BOOKED
  WON
  LOST
  SUPPRESSED
  ARCHIVED
}

enum ContactChannel {
  EMAIL
  PHONE
  OTHER
}

enum ContactOrigin {
  LEDGER_IMPORT_CSV
  LEDGER_IMPORT_GMAIL
  LEDGER_IMPORT_CRM
  OUTBOUND_SEND
  REPLY
  MANUAL
  SUPPRESSION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
  SIMULATED
}

enum ReplyClassification {
  INTERESTED
  OBJECTION
  UNSUBSCRIBE
  OUT_OF_OFFICE
  BOUNCE
  OTHER
  UNCLASSIFIED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  BUDGET_EXHAUSTED
}

enum CostCategory {
  EMAIL_FINDER
  ENRICHMENT
  LLM
  AUDIT
  OTHER
}

// ===========================================================================
// AUTH.JS COMPATIBLE MODELS
// ===========================================================================

model User {
  id             String    @id @default(cuid())
  workspaceId    String
  email          String
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  role           Role      @default(OPERATOR)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  Account[]
  sessions  Session[]

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===========================================================================
// WORKSPACE
// ===========================================================================

model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  legalAddress  String?
  primaryDomain String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  users                User[]
  icps                 Icp[]
  playbooks            Playbook[]
  sourceConfigs        SourceConfig[]
  leads                Lead[]
  contactHistoryLedger ContactHistoryLedger[]
  campaigns            Campaign[]
  sequences            Sequence[]
  suppressionList      SuppressionList[]
  costLedger           CostLedger[]
  runs                 Run[]

  @@map("workspaces")
}

// ===========================================================================
// ICP + PLAYBOOK + SOURCE CONFIG (Phase 2)
// ===========================================================================

model Icp {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  verticals      Vertical[]
  countries      CountryCode[]
  geoFilters     Json?
  minRating      Float?
  minReviews     Int?
  minAuditScore  Float?
  requireWebsite Boolean       @default(true)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playbooks Playbook[]
  runs      Run[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("icps")
}

model Playbook {
  id             String    @id @default(cuid())
  workspaceId    String
  icpId          String?
  name           String
  description    String?
  offerName      String?
  offerSummary   String?   @db.Text
  sequenceConfig Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icp       Icp?       @relation(fields: [icpId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([workspaceId])
  @@index([icpId])
  @@map("playbooks")
}

model SourceConfig {
  id                   String         @id @default(cuid())
  workspaceId          String
  provider             SourceProvider
  name                 String
  isEnabled            Boolean        @default(false)
  maxRequestsPerMinute Int            @default(30)
  maxCreditsPerRun     Int?
  config               Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("source_configs")
}

// ===========================================================================
// LEADS + ENRICHMENT + SCORE + AUDIT (Phase 3)
// ===========================================================================

model Lead {
  id              String      @id @default(cuid())
  workspaceId     String
  // Identity
  companyName     String
  normalizedName  String?     // for dedup
  website         String?
  domain          String?     // extracted, normalized
  // Location
  country         CountryCode?
  region          String?     // state / county
  city            String?
  postalCode      String?
  address         String?
  // Classification
  vertical        Vertical?
  status          LeadStatus  @default(DISCOVERED)
  // Provenance
  sourceProvider  SourceProvider?
  sourceRef       String?     // registry ID / query ref
  sourceMeta      Json?       // raw provenance
  // Contact hints (before full enrichment)
  primaryEmail    String?
  primaryPhone    String?
  // Soft-delete + timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrichments  LeadEnrichment[]
  scores       LeadScore[]
  auditResults AuditResult[]
  outbox       EmailOutbox[]
  sent         EmailSent[]
  replies      Reply[]
  meetings     Meeting[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, domain])
  @@index([workspaceId, normalizedName])
  @@index([primaryEmail])
  @@map("leads")
}

model LeadEnrichment {
  id          String   @id @default(cuid())
  leadId      String
  provider    String   // e.g. google_places, yelp, website
  // Common enrichment fields
  rating      Float?
  reviewCount Int?
  website     String?
  phone       String?
  email       String?
  raw         Json?    // full provider payload
  enrichedAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_enrichments")
}

model LeadScore {
  id          String   @id @default(cuid())
  leadId      String
  totalScore  Float    // 0–100
  // Explainable breakdown (weights applied)
  breakdown   Json     // { audit: 40, rating: 15, reviews: 10, ... }
  weightsUsed Json?    // snapshot of weights at scoring time
  scoredAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([totalScore])
  @@map("lead_scores")
}

model AuditResult {
  id          String   @id @default(cuid())
  leadId      String
  url         String   // audited URL
  score       Float    // 0–100 overall
  findings    Json     // structured findings from agency audit tool
  rawReport   Json?    // full report if stored
  auditedAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([score])
  @@map("audit_results")
}

// ===========================================================================
// CONTACT HISTORY LEDGER (append-only, single source of truth)
// ===========================================================================

model ContactHistoryLedger {
  id               String         @id @default(cuid())
  workspaceId      String
  // Normalized identity – uniqueness enforced per workspace
  normalizedEmail  String?
  normalizedPhone  String?
  domain           String?
  // Original values
  email            String?
  phone            String?
  // Provenance
  origin           ContactOrigin
  channel          ContactChannel @default(EMAIL)
  sourceOfTruth    String?        // e.g. filename, gmail message id
  firstContactedAt DateTime
  lastContactedAt  DateTime
  notes            String?
  createdAt        DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Fast lookups – unique on normalized email/phone per workspace when present
  @@unique([workspaceId, normalizedEmail])
  @@unique([workspaceId, normalizedPhone])
  @@index([workspaceId])
  @@index([workspaceId, domain])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("contact_history_ledger")
}

// ===========================================================================
// CAMPAIGNS + SEQUENCES + OUTBOX + SENT + REPLIES
// ===========================================================================

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  playbookId  String?
  name        String
  status      CampaignStatus @default(DRAFT)
  isSimulation Boolean       @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playbook  Playbook?     @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  sequences Sequence[]
  outbox    EmailOutbox[]
  sent      EmailSent[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("campaigns")
}

model Sequence {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  name        String
  steps       Json     // ordered steps: delay, template ref, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("sequences")
}

model EmailOutbox {
  id           String       @id @default(cuid())
  workspaceId  String?      // denormalized for queries; cascade via lead/campaign
  leadId       String
  campaignId   String?
  // Content
  toEmail      String
  toName       String?
  subject      String
  bodyHtml     String       @db.Text
  bodyText     String?      @db.Text
  // Facts used for grounding (validator input)
  factsUsed    Json?
  // Status + locking for workers
  status       OutboxStatus @default(DRAFT)
  lockedAt     DateTime?
  lockedBy     String?      // worker id
  scheduledAt  DateTime?
  attemptCount Int          @default(0)
  lastError    String?
  isSimulation Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([campaignId])
  @@index([status, scheduledAt])
  @@index([toEmail])
  @@map("emails_outbox")
}

model EmailSent {
  id           String   @id @default(cuid())
  leadId       String
  campaignId   String?
  outboxId     String?  @unique
  toEmail      String
  subject      String
  bodyHtml     String   @db.Text
  providerMessageId String?
  mailboxId    String?  // which secondary domain mailbox
  sentAt       DateTime @default(now())
  isSimulation Boolean  @default(false)

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  replies  Reply[]

  @@index([leadId])
  @@index([campaignId])
  @@index([toEmail])
  @@index([sentAt])
  @@map("emails_sent")
}

model Reply {
  id             String              @id @default(cuid())
  leadId         String
  emailSentId    String?
  fromEmail      String
  subject        String?
  bodyText       String?             @db.Text
  classification ReplyClassification @default(UNCLASSIFIED)
  raw            Json?
  receivedAt     DateTime            @default(now())

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailSent EmailSent? @relation(fields: [emailSentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([classification])
  @@index([fromEmail])
  @@map("replies")
}

// ===========================================================================
// MEETINGS
// ===========================================================================

model Meeting {
  id          String        @id @default(cuid())
  leadId      String
  title       String?
  startsAt    DateTime
  endsAt      DateTime?
  status      MeetingStatus @default(SCHEDULED)
  calendarEventId String?
  meetingUrl  String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([startsAt])
  @@index([status])
  @@map("meetings")
}

// ===========================================================================
// SUPPRESSION LIST
// ===========================================================================

model SuppressionList {
  id              String    @id @default(cuid())
  workspaceId     String
  normalizedEmail String?
  normalizedPhone String?
  domain          String?
  reason          String?   // unsubscribe, bounce, manual, legal
  source          String?
  createdAt       DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedEmail])
  @@unique([workspaceId, normalizedPhone])
  @@index([workspaceId])
  @@index([domain])
  @@map("suppression_list")
}

// ===========================================================================
// COST LEDGER + RUNS
// ===========================================================================

model CostLedger {
  id          String       @id @default(cuid())
  workspaceId String
  runId       String?
  category    CostCategory
  provider    String?      // openai, anthropic, hunter, etc.
  units       Float        @default(1)
  unitCost    Float?       // credits or USD
  totalCost   Float?
  meta        Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([runId])
  @@index([category])
  @@index([createdAt])
  @@map("cost_ledger")
}

model Run {
  id             String    @id @default(cuid())
  workspaceId    String
  icpId          String?
  name           String?
  // Goal-based: "find N qualified leads, max C credits"
  goalLeadCount  Int?
  maxCredits     Int?
  creditsUsed    Float     @default(0)
  leadsFound     Int       @default(0)
  leadsQualified Int       @default(0)
  status         RunStatus @default(PENDING)
  isSimulation   Boolean   @default(true)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icp        Icp?         @relation(fields: [icpId], references: [id], onDelete: SetNull)
  costEntries CostLedger[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([icpId])
  @@map("runs")
}
