// LeadPilot Retainer Edition – Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum Vertical {
  DENTAL_ORTHO
  HOME_SERVICES
  AESTHETIC_MEDSPA
  OTHER
}

enum CountryCode {
  US
  UK
  AU
}

enum SourceProvider {
  NPI_US
  STATE_LICENSE_US
  COMPANIES_HOUSE_UK
  ABN_ASIC_AU
  HEALTH_REGISTER_AU
  JOB_BOARD
  GOOGLE_PLACES_ENRICH
  YELP_ENRICH
  WEBSITE_EXTRACT
  CUSTOM
}

enum LeadStatus {
  DISCOVERED
  ENRICHING
  ENRICHED
  SCORED
  QUALIFIED
  EMAIL_RESOLVED
  IN_CAMPAIGN
  CONTACTED
  REPLIED
  MEETING_BOOKED
  WON
  LOST
  SUPPRESSED
  ARCHIVED
}

enum ContactChannel {
  EMAIL
  PHONE
  OTHER
}

enum ContactOrigin {
  LEDGER_IMPORT_CSV
  LEDGER_IMPORT_GMAIL
  LEDGER_IMPORT_CRM
  OUTBOUND_SEND
  REPLY
  MANUAL
  SUPPRESSION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
  SIMULATED
}

enum ReplyClassification {
  INTERESTED
  OBJECTION
  UNSUBSCRIBE
  OUT_OF_OFFICE
  BOUNCE
  OTHER
  UNCLASSIFIED
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  BUDGET_EXHAUSTED
}

enum CostCategory {
  EMAIL_FINDER
  ENRICHMENT
  LLM
  AUDIT
  OTHER
}

model User {
  id             String    @id @default(cuid())
  workspaceId    String
  email          String
  emailVerified  DateTime?
  name           String?
  image          String?
  passwordHash   String?
  role           Role      @default(OPERATOR)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts  Account[]
  sessions  Session[]

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  legalAddress  String?
  primaryDomain String?
  killSwitch    Boolean   @default(false)
  planCode      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  users                User[]
  icps                 Icp[]
  playbooks            Playbook[]
  sourceConfigs        SourceConfig[]
  leads                Lead[]
  contactHistoryLedger ContactHistoryLedger[]
  campaigns            Campaign[]
  sequences            Sequence[]
  suppressionList      SuppressionList[]
  costLedger           CostLedger[]
  runs                 Run[]

  @@map("workspaces")
}

model SiteEvent {
  id          String   @id @default(cuid())
  name        String
  path        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  sessionId   String?
  ipHash      String?
  userAgent   String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([name])
  @@index([createdAt])
  @@index([path])
  @@map("site_events")
}

model Icp {
  id             String        @id @default(cuid())
  workspaceId    String
  name           String
  description    String?
  verticals      Vertical[]
  countries      CountryCode[]
  geoFilters     Json?
  minRating      Float?
  minReviews     Int?
  minAuditScore  Float?
  requireWebsite Boolean       @default(true)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playbooks Playbook[]
  runs      Run[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("icps")
}

model Playbook {
  id             String    @id @default(cuid())
  workspaceId    String
  icpId          String?
  name           String
  description    String?
  offerName      String?
  offerSummary   String?   @db.Text
  sequenceConfig Json?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icp       Icp?       @relation(fields: [icpId], references: [id], onDelete: SetNull)
  campaigns Campaign[]

  @@index([workspaceId])
  @@index([icpId])
  @@map("playbooks")
}

model SourceConfig {
  id                   String         @id @default(cuid())
  workspaceId          String
  provider             SourceProvider
  name                 String
  isEnabled            Boolean        @default(false)
  maxRequestsPerMinute Int            @default(30)
  maxCreditsPerRun     Int?
  config               Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@map("source_configs")
}

model Lead {
  id             String       @id @default(cuid())
  workspaceId    String
  companyName    String
  normalizedName String?
  website        String?
  domain         String?
  country        CountryCode?
  region         String?
  city           String?
  postalCode     String?
  address        String?
  vertical       Vertical?
  status         LeadStatus   @default(DISCOVERED)
  sourceProvider SourceProvider?
  sourceRef      String?
  sourceMeta     Json?
  primaryEmail   String?
  primaryPhone   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrichments  LeadEnrichment[]
  scores       LeadScore[]
  auditResults AuditResult[]
  outbox       EmailOutbox[]
  sent         EmailSent[]
  replies      Reply[]
  meetings     Meeting[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, domain])
  @@index([workspaceId, normalizedName])
  @@index([primaryEmail])
  @@map("leads")
}

model LeadEnrichment {
  id          String   @id @default(cuid())
  leadId      String
  provider    String
  rating      Float?
  reviewCount Int?
  website     String?
  phone       String?
  email       String?
  raw         Json?
  enrichedAt  DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_enrichments")
}

model LeadScore {
  id          String   @id @default(cuid())
  leadId      String
  totalScore  Float
  breakdown   Json
  weightsUsed Json?
  scoredAt    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([totalScore])
  @@map("lead_scores")
}

model AuditResult {
  id        String   @id @default(cuid())
  leadId    String
  url       String
  score     Float
  findings  Json
  rawReport Json?
  auditedAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([score])
  @@map("audit_results")
}

model ContactHistoryLedger {
  id               String         @id @default(cuid())
  workspaceId      String
  normalizedEmail  String?
  normalizedPhone  String?
  domain           String?
  email            String?
  phone            String?
  origin           ContactOrigin
  channel          ContactChannel @default(EMAIL)
  sourceOfTruth    String?
  firstContactedAt DateTime
  lastContactedAt  DateTime
  notes            String?
  createdAt        DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedEmail])
  @@unique([workspaceId, normalizedPhone])
  @@index([workspaceId])
  @@index([workspaceId, domain])
  @@index([normalizedEmail])
  @@index([normalizedPhone])
  @@map("contact_history_ledger")
}

model Campaign {
  id           String         @id @default(cuid())
  workspaceId  String
  playbookId   String?
  name         String
  status       CampaignStatus @default(DRAFT)
  isSimulation Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  playbook  Playbook?     @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  sequences Sequence[]
  outbox    EmailOutbox[]
  sent      EmailSent[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("campaigns")
}

model Sequence {
  id          String   @id @default(cuid())
  workspaceId  String
  campaignId  String?
  name        String
  steps       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("sequences")
}

model EmailOutbox {
  id           String       @id @default(cuid())
  workspaceId  String?
  leadId       String
  campaignId   String?
  toEmail      String
  toName       String?
  subject      String
  bodyHtml     String       @db.Text
  bodyText     String?      @db.Text
  factsUsed    Json?
  status       OutboxStatus @default(DRAFT)
  lockedAt     DateTime?
  lockedBy     String?
  scheduledAt  DateTime?
  attemptCount Int          @default(0)
  lastError    String?
  isSimulation Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([campaignId])
  @@index([status, scheduledAt])
  @@index([toEmail])
  @@map("emails_outbox")
}

model EmailSent {
  id                String   @id @default(cuid())
  leadId            String
  campaignId        String?
  outboxId          String?  @unique
  toEmail           String
  subject           String
  bodyHtml          String   @db.Text
  providerMessageId String?
  mailboxId         String?
  sentAt            DateTime @default(now())
  isSimulation      Boolean  @default(false)

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  replies  Reply[]

  @@index([leadId])
  @@index([campaignId])
  @@index([toEmail])
  @@index([sentAt])
  @@map("emails_sent")
}

model Reply {
  id             String              @id @default(cuid())
  leadId         String
  emailSentId    String?
  fromEmail      String
  subject        String?
  bodyText       String?             @db.Text
  classification ReplyClassification @default(UNCLASSIFIED)
  raw            Json?
  receivedAt     DateTime            @default(now())

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  emailSent EmailSent? @relation(fields: [emailSentId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([classification])
  @@index([fromEmail])
  @@map("replies")
}

model Meeting {
  id              String        @id @default(cuid())
  leadId          String
  title           String?
  startsAt        DateTime
  endsAt          DateTime?
  status          MeetingStatus @default(SCHEDULED)
  calendarEventId String?
  meetingUrl      String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([startsAt])
  @@index([status])
  @@map("meetings")
}

model SuppressionList {
  id              String   @id @default(cuid())
  workspaceId     String
  normalizedEmail String?
  normalizedPhone String?
  domain          String?
  reason          String?
  source          String?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, normalizedEmail])
  @@unique([workspaceId, normalizedPhone])
  @@index([workspaceId])
  @@index([domain])
  @@map("suppression_list")
}

model CostLedger {
  id          String       @id @default(cuid())
  workspaceId String
  runId       String?
  category    CostCategory
  provider    String?
  units       Float        @default(1)
  unitCost    Float?
  totalCost   Float?
  meta        Json?
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       Run?      @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([runId])
  @@index([category])
  @@index([createdAt])
  @@map("cost_ledger")
}

model Run {
  id             String    @id @default(cuid())
  workspaceId    String
  icpId          String?
  name           String?
  goalLeadCount  Int?
  maxCredits     Int?
  creditsUsed    Float     @default(0)
  leadsFound     Int       @default(0)
  leadsQualified Int       @default(0)
  status         RunStatus @default(PENDING)
  isSimulation   Boolean   @default(true)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icp         Icp?         @relation(fields: [icpId], references: [id], onDelete: SetNull)
  costEntries CostLedger[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([icpId])
  @@map("runs")
}
