{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@leadpilot/shared": ["../../packages/shared/src"],
      "@leadpilot/shared/*": ["../../packages/shared/src/*"],
      "@leadpilot/db": ["../../packages/db/src"],
      "@leadpilot/db/*": ["../../packages/db/src/*"],
      "@leadpilot/sources": ["../../packages/sources/src"],
      "@leadpilot/sources/*": ["../../packages/sources/src/*"],
      "@leadpilot/audit": ["../../packages/audit/src"],
      "@leadpilot/audit/*": ["../../packages/audit/src/*"],
      "@leadpilot/scoring": ["../../packages/scoring/src"],
      "@leadpilot/scoring/*": ["../../packages/scoring/src/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "moduleResolution": "bundler"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
